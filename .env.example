# Copy to `.env` (git-ignored) or let scripts/_lib.sh write it for you on
# the first `./scripts/*.sh` run. Secrets do NOT belong here: the agents
# read OPENROUTER_API_KEY / ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN
# from the shell that starts compose.

# Absolute path of this checkout. Mounted at the same path inside every
# container so `cwd` means one thing on both sides.
WORKSPACE=/abs/path/to/athanore-v1
HOST_HOME=/home/you

# Own the files the container writes into the checkout.
UID=1000
GID=1000
# `getent group docker | cut -d: -f3` — lets the container use the socket.
DOCKER_GID=999

# Where `app` binds. Loopback needs no operator token (12 §Auth).
ATHANORE_HOST=127.0.0.1
ATHANORE_PORT=4002

# Vite dev server (T007) and the Postgres profile (T014).
WEB_HOST=127.0.0.1
WEB_PORT=5173
POSTGRES_PORT=5433

# Pinned toolchain. Bump deliberately; a floating agent adapter is S7.
UV_VERSION=0.12.10
PYTHON_VERSION=3.13
PI_VERSION=0.85.1
PI_ACP_VERSION=0.0.33
CLAUDE_CODE_VERSION=2.1.261
CLAUDE_ACP_VERSION=0.75.1
PLAYWRIGHT_VERSION=1.63.0
# Chromium in the image: the QA node drives the SPA with Playwright, and
# T068's suite needs it too.
WITH_BROWSERS=1
