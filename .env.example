# Copy to `.env` (git-ignored) or let scripts/_lib.sh write it for you on
# the first `./scripts/*.sh` run. Secrets do NOT belong here: the agents
# read OPENROUTER_API_KEY / ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN
# from the shell that starts compose.

# Absolute path of this checkout. Mounted at the same path inside every
# container so `cwd` means one thing on both sides.
WORKSPACE=/abs/path/to/athanore-v1
HOST_HOME=/home/you

# Own the files the container writes into the checkout.
UID=1000
GID=1000
# `getent group docker | cut -d: -f3` — lets the container use the socket.
DOCKER_GID=999

# Where `app` binds. Loopback needs no operator token (12 §Auth).
ATHANORE_HOST=127.0.0.1
ATHANORE_PORT=4002

# Vite dev server (T007) and the Postgres profile (T014).
WEB_HOST=127.0.0.1
WEB_PORT=5173
POSTGRES_PORT=5433

# The `drive` profile: athanore v0 dispatching the serial plan (D67).
# MAIN_CHECKOUT is the v0 checkout; driver/pyproject.toml expects it as a
# sibling of this one.
MAIN_CHECKOUT=/home/you/Projects/athanore
# One model writes, a different one reviews and QAs it. Ids are
# `<pi provider>/<model id>` and must exist in docker/dev/pi/models.json:
# pi falls back to its own default for an id it does not know, so a typo
# here buys you the cheap model without saying so.
BUILDER_IMPLEMENT_MODEL=openrouter/deepseek/deepseek-v4-pro-0813
BUILDER_REVIEW_MODEL=openrouter/qwen/qwen3.8-max-0902
BUILDER_QA_MODEL=openrouter/qwen/qwen3.8-max-0902
# Rounds back to `implement` per lane (gate, review, qa), and in total,
# before the run fails and the rest of the queue is paused.
BUILDER_MAX_LOOPS=3
BUILDER_MAX_ATTEMPTS=6
# Seconds one agent turn may take.
BUILDER_AGENT_TIMEOUT=10800
# 1 stops before every merge so you can read the branch first.
BUILDER_ATTENDED=1
# 4102, not 4002: the v1 app owns 4002.
BUILDER_PORT=4102
BUILDER_WEB_PORT=2424

# Pinned toolchain. Bump deliberately; a floating agent adapter is S7.
UV_VERSION=0.12.10
PYTHON_VERSION=3.13
PI_VERSION=0.85.1
PI_ACP_VERSION=0.0.33
CLAUDE_CODE_VERSION=2.1.261
CLAUDE_ACP_VERSION=0.75.1
PLAYWRIGHT_VERSION=1.63.0
# Chromium in the image: the QA node drives the SPA with Playwright, and
# T068's suite needs it too.
WITH_BROWSERS=1
